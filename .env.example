# Central CMS â€” environment template. Copy to `.env.local` and fill in.
# Only the Central CMS holds DATABASE_URL. Frontends and engines talk HTTP only.
#
# For a zero-config local DB, use docker-compose.yml + `.env.docker.example`
# instead (a local Postgres, no Supabase needed).
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Postgres (Supabase). Pooled URL for runtime; direct URL for migrations (DDL).
# Local docker DB:  postgresql://postgres:password@localhost:54326/central_cms
DATABASE_URL=postgresql://user:pass@host:6543/postgres
DATABASE_DIRECT_URL=postgresql://user:pass@host:5432/postgres

# Local dev only: with no committed migrations, set this to let Payload sync the
# schema on boot. Leave unset (false) in deployed envs â€” they use migrations.
PAYLOAD_DB_PUSH=false

# Payload â€” generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# First system-admin user, created by the seed script.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now

# Optional: pin a deterministic engine token on first seed (local dev / testing).
# If unset, the seed prints a random engine token once. Must match the
# engine-intake-tester's ENGINE_INTAKE_TOKEN to drive the local intake loop.
SEED_ENGINE_TOKEN=

# Cloudflare R2 (S3-compatible). One bucket, per-tenant key prefix.
# Omit all four locally to fall back to local-disk media in dev.
R2_BUCKET=central-media
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional, deployed envs with R2 only: the bucket's public custom domain (not
# r2.dev), e.g. https://img.apcgmedia.com; a value that is not an absolute
# http(s) URL is ignored with a warning (media stays on /api/media/file). It is used
# in canonical URL form (no query, fragment or credentials) and only together with
# the four R2_* vars above, one switch for Payload URLs and the redirect. When on,
# media/videoMedia URLs become <base>/<tenant-prefix>/<filename> and old
# /api/media/file/<name>?prefix=<t> links 302 there. Attach the domain and deploy
# the redirect BEFORE setting it; rollback = unset + redeploy (keep the domain attached).
# R2_PUBLIC_BASE_URL=

# Signing secret for preview tokens and revalidate webhooks (HMAC).
# generate with: openssl rand -hex 32
CENTRAL_SIGNING_SECRET=generate-with-openssl-rand-hex-32-must-match-central-CENTRAL_SIGNING_SECRET

# Comma-separated list of frontend origins allowed to call the public API (CORS).
# e.g. https://briefasia.com,https://opentechwire.com
PUBLIC_API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
PORT=3508

# Bearer token Vercel Cron sends to /api/cron/publish-scheduled (hourly, see
# vercel.json). That route flips scheduled articles to published for EVERY tenant.
# ChÆ°a set + production => route tráº£ 503 (fail closed, KHĂ”NG bao giá» má»Ÿ); chÆ°a set +
# non-production => má»Ÿ cho curl local. generate with: openssl rand -hex 32
CRON_SECRET=
