{
  "name": "central-cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3508",
    "build": "payload generate:importmap && next build",
    "vercel-build": "node scripts/migrate-prod.mjs && npm run build",
    "migrate:prod": "node scripts/migrate-prod.mjs",
    "start": "next start -p 3508",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:media-redirect": "tsx --test src/lib/media-redirect.test.ts",
    "test:hub-media": "tsx --test src/lib/hub-media-validate.test.ts src/lib/media-create.test.ts src/lib/hub-author-media-token.test.ts",
    "test:hub-live": "tsx --test src/lib/hub-author-live-pure.test.ts src/lib/hub-author-live-core.test.ts",
    "test:hub-p56": "tsx --test src/lib/hub-author-preview-pure.test.ts src/lib/hub-author-preview-core.test.ts src/lib/hub-taxonomy-create-pure.test.ts src/lib/hub-taxonomy-create-core.test.ts",
    "audit:add-gtp-taxonomy": "tsx scripts/audit/add-gtp-taxonomy.ts",
    "audit:add-vowasia-taxonomy": "tsx scripts/audit/add-vowasia-taxonomy.ts",
    "probe:gtp": "tsx scripts/gtp-probe.ts",
    "test:single-home": "tsx --test src/lib/single-home-pillars.test.ts src/hooks/single-home-pillar.test.ts scripts/lib/local-db-guard.test.ts scripts/lib/gtp-taxonomy.test.ts scripts/lib/vowasia-taxonomy.test.ts scripts/lib/central-db-name-guard.test.ts",
    "payload": "payload",
    "payload:generate-types": "payload generate:types",
    "payload:generate-importmap": "payload generate:importmap",
    "payload:migrate": "payload migrate",
    "payload:migrate:create": "payload migrate:create",
    "db:seed": "tsx scripts/seed.ts",
    "r2:cors": "tsx scripts/set-r2-cors.ts",
    "db:status": "tsx scripts/db-status.ts",
    "migrate:export": "tsx scripts/migrate/export-source.ts",
    "migrate:import": "tsx scripts/migrate/import-central.ts",
    "migrate:gcv-legacy": "tsx scripts/migrate/import-gcv-legacy.ts",
    "migrate:users": "tsx scripts/migrate/import-users.ts",
    "migrate:media": "tsx scripts/migrate/copy-media.ts",
    "migrate:reader-backfill": "tsx scripts/migrate/reader-id-backfill.ts",
    "migrate:author-slugs": "tsx scripts/migrate/backfill-author-slugs.ts",
    "migrate:sync-views": "tsx scripts/migrate/sync-view-counts.ts",
    "migrate:fix-body-uploads": "tsx scripts/migrate/fix-body-upload-refs.ts",
    "migrate:gtp:discover": "tsx scripts/migrate/discover-legacy-pg.ts",
    "migrate:gtp:export": "tsx scripts/migrate/export-gtp-legacy.ts",
    "migrate:gtp:validate-mapping": "tsx scripts/migrate/validate-gtp-mapping.ts",
    "migrate:gtp:import": "tsx scripts/migrate/import-gtp-legacy.ts",
    "migrate:gtp:rewrite-links": "tsx scripts/migrate/rewrite-links-gtp.ts",
    "migrate:gtp:rollback": "tsx scripts/migrate/rollback-gtp-import.ts",
    "migrate:gtp:redirects": "tsx scripts/migrate/build-gtp-redirects.ts",
    "migrate:gtp:verify": "tsx scripts/migrate/verify-gtp-parity.ts",
    "migrate:gtp:fixture": "tsx scripts/migrate/fixtures/gtp-legacy/seed-gtp-legacy-fixture.ts",
    "rehearse:gtp": "bash scripts/migrate/fixtures/gtp-legacy/rehearse-gtp.sh",
    "lint:migrate": "eslint scripts/migrate --ignore-pattern \"scripts/migrate/out/**\"",
    "test:migrate-gtp": "tsx --test scripts/migrate/lib/*.test.ts",
    "audit:gcv-export": "tsx scripts/audit/gcv-audit-export.ts",
    "audit:apply-luxury": "tsx scripts/audit/apply-luxury-decisions.ts",
    "audit:migrate-lifestyle": "tsx scripts/audit/migrate-lifestyle-subsections.ts",
    "audit:add-pressroom": "tsx scripts/audit/add-pressroom-pillar.ts",
    "probe:single-home": "tsx scripts/single-home-probe.ts",
    "probe:public-tags": "tsx scripts/public-tags-probe.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@payloadcms/db-postgres": "3.85.1",
    "@payloadcms/next": "3.85.1",
    "@payloadcms/plugin-multi-tenant": "3.85.1",
    "@payloadcms/richtext-lexical": "3.85.1",
    "@payloadcms/storage-s3": "3.85.1",
    "@tailwindcss/postcss": "^4.3.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.0",
    "next": "15.4.11",
    "payload": "3.85.1",
    "postcss": "^8.5.16",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.4.11",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "zod": "^4.6.6"
  }
}
