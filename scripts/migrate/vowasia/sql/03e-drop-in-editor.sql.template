-- OWNER-RUN. KHÔNG tự chạy. Đọc scripts/migrate/vowasia/VOWASIA-LEGACY.md (Cách B, bước B6) trước.
--
-- 03e-drop-in-editor.sql.template: bản của 03-drop-role-and-views.sql cho SQL Editor
-- của Supabase (Editor không có biến psql như -v legacy_db). Cùng logic với 03:
-- xoá schema vowasia_ro (kèm hai view), mọi quyền/đối tượng của vowasia_migrator
-- trong database này, rồi xoá role. Không đụng bảng gốc, không đụng role khác.
--
-- Cách dùng: dán CẢ file vào SQL Editor, thay __LEGACY_DB_NAME__ (mọi lần xuất hiện:
-- tìm-và-thay của Editor là Cmd+Option+F trên Mac, Ctrl+H trên Windows/Linux, rồi bấm
-- Replace All; sau đó tìm '__' để chắc không còn chỗ giữ chỗ) bằng tên database CŨ
-- (dòng '1 connection' của 01e; với Supabase thường là postgres), rồi Run. Ô kết quả
-- cuối, cột vowasia_cleanup_check, phải là đúng 'CLEANUP OK'; các cột còn lại của
-- cùng hàng cho trạng thái RLS/policy SAU khi dọn (Editor không hiện NOTICE).
-- Toàn bộ phần xoá nằm trong MỘT giao dịch (BEGIN ... COMMIT): placeholder chưa điền,
-- nối vào 'neondb' (Central) hoặc database khác tên đã điền => lỗi 'STOP', giao dịch
-- bị huỷ, KHÔNG xoá gì (khi chạy bằng psql không có ON_ERROR_STOP, các lệnh sau lỗi
-- đều bị từ chối và COMMIT thành ROLLBACK; dòng cuối là 'CLEANUP STOP: ...').
-- Thứ tự quan trọng: DROP SCHEMA, rồi DROP OWNED BY, rồi DROP ROLE.
-- Nếu role còn quyền ở database KHÁC trong cùng cụm: chạy DROP OWNED BY ở database đó trước.
-- Chạy lại nhiều lần vẫn an toàn.
-- Cách B KHÔNG dùng 02b (xem VOWASIA-LEGACY.md B3). 03e KHÔNG tắt RLS: nếu lỡ đã dùng
-- 02b, gỡ policy và (chỉ khi trước đó RLS đang tắt) tắt RLS BẰNG TAY TRƯỚC, theo đầu
-- file 02b, rồi DỪNG và báo.

-- Đang nối vào đâu, bằng ai (chỉ để ghi lại; chốt thật là khối DO ngay dưới).
SELECT current_database() AS database_name, current_user AS running_as;

BEGIN;

-- set_config(..., true): chỉ sống trong giao dịch này; khối DO ngay dưới đọc nó trong
-- cùng giao dịch. Lỗi ở bất kỳ dòng nào => cả giao dịch huỷ, không xoá gì.
SELECT set_config('vowasia.legacy_db', '__LEGACY_DB_NAME__', true) IS NOT NULL AS legacy_db_given;
DO $$
BEGIN
  IF current_setting('vowasia.legacy_db', true) LIKE '\_\_LEGACY%' THEN
    RAISE EXCEPTION 'DB NAME STOP: placeholder __LEGACY_DB_NAME__ not filled; nothing was dropped.';
  END IF;
  IF current_database() = 'neondb' THEN
    RAISE EXCEPTION 'DB NAME STOP: connected to neondb (Central), not the old database; nothing was dropped.';
  END IF;
  IF coalesce(current_setting('vowasia.legacy_db', true), '') = '' OR current_database() <> current_setting('vowasia.legacy_db', true) THEN
    RAISE EXCEPTION 'DB NAME STOP: connected database is not the given legacy_db; nothing was dropped.';
  END IF;
END $$;

DROP SCHEMA IF EXISTS vowasia_ro CASCADE;

DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'vowasia_migrator') THEN
    BEGIN
      EXECUTE 'DROP OWNED BY vowasia_migrator';
    EXCEPTION WHEN insufficient_privilege THEN
      -- Chủ không phải superuser (có CREATEROLE, như Supabase/Neon): PG 16 chỉ cho
      -- DROP OWNED khi có quyền của role đó. Người tạo role giữ ADMIN OPTION nên tự
      -- cấp được; quyền này mất theo role ở DROP ROLE ngay dưới.
      EXECUTE format('GRANT vowasia_migrator TO %I', current_user);
      EXECUTE 'DROP OWNED BY vowasia_migrator';
    END;
  END IF;
END $$;

DROP ROLE IF EXISTS vowasia_migrator;

COMMIT;

-- Xác nhận cuối (ô kết quả, KHÔNG dựa vào NOTICE): cột đầu phải là đúng 'CLEANUP OK'.
-- Các cột sau: trạng thái RLS của hai bảng gốc và số policy vowasia_migrator_* còn lại
-- ('missing' nếu bảng không có), để đối chiếu nếu đã lỡ dùng 02b.
SELECT CASE
  WHEN EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'vowasia_migrator') THEN 'CLEANUP STOP: role vowasia_migrator still exists'
  WHEN EXISTS (SELECT 1 FROM pg_namespace WHERE nspname = 'vowasia_ro') THEN 'CLEANUP STOP: schema vowasia_ro still exists'
  ELSE 'CLEANUP OK'
END AS vowasia_cleanup_check,
  coalesce((SELECT c.relrowsecurity::text FROM pg_class c WHERE c.oid = to_regclass('public.articles')), 'missing') AS articles_rls_enabled,
  coalesce((SELECT c.relrowsecurity::text FROM pg_class c WHERE c.oid = to_regclass('public.sites')), 'missing') AS sites_rls_enabled,
  (SELECT count(*) FROM pg_policies p WHERE p.schemaname = 'public' AND p.tablename IN ('articles', 'sites') AND p.policyname LIKE 'vowasia\_migrator\_%') AS vowasia_policies_left;
