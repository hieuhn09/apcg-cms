-- OWNER-RUN. KHÔNG tự chạy. Đọc scripts/migrate/vowasia/VOWASIA-LEGACY.md (Cách B, bước B4) trước.
--
-- 02p-set-password.sql.template: đặt mật khẩu cho role vowasia_migrator từ SQL Editor
-- của Supabase (thay cho lệnh psql \password của cách A).
--   - KHÔNG có chỗ giữ chỗ, KHÔNG gõ hay dán mật khẩu vào đây: file tự sinh mật khẩu
--     ngẫu nhiên 64 ký tự hex (0-9, a-f) bằng gen_random_uuid(), đặt cho role, rồi
--     hiện nó ĐÚNG MỘT LẦN ở ô kết quả cuối (cột new_secret). Văn bản truy vấn không
--     chứa bí mật nào, nên lịch sử truy vấn của Editor không giữ mật khẩu.
--   - Dán CẢ file như MỘT truy vấn rồi Run (Editor chạy cả file trong một giao dịch;
--     giá trị chỉ sống trong giao dịch đó). Chạy từng câu riêng (hay psql -f không
--     có -1) thì ô cuối báo 'NOT SHOWN': mật khẩu đã bị đổi nhưng không ai thấy; chạy
--     lại cả file trong Editor.
--   - DỪNG (lỗi '02P STOP', không đổi gì) nếu role vowasia_migrator không tồn tại,
--     nếu schema vowasia_ro không tồn tại, hoặc nếu role chưa ở đúng trạng thái mà
--     file 02 kiểm (hai view, quyền SELECT, không superuser/BYPASSRLS, không là thành
--     viên role khác). Tức là CHỈ chạy SAU khi 02 đã báo đúng 'SELF-CHECK OK'.
--   - MỖI lần chạy sinh mật khẩu MỚI và thay mật khẩu cũ (URL cũ hết dùng được).
--   - Chép giá trị ô new_secret bằng nút copy của ô kết quả, nhập vào terminal bằng
--     read -s (VOWASIA-LEGACY.md, B5). Không chụp màn hình ô đó, không dán vào chat.
--     Xong thì đóng tab truy vấn / xoá snippet để ô kết quả không còn trên màn hình.
--   - Đổi mật khẩu KHÔNG gia hạn VALID UNTIL (14 ngày) của role.

DO $$
DECLARE
  pw text;
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'vowasia_migrator') THEN
    RAISE EXCEPTION '02P STOP: role vowasia_migrator does not exist (run 02 first, it must end in SELF-CHECK OK); nothing was changed.';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_namespace WHERE nspname = 'vowasia_ro') THEN
    RAISE EXCEPTION '02P STOP: schema vowasia_ro does not exist (run 02 first, it must end in SELF-CHECK OK); nothing was changed.';
  END IF;
  IF to_regclass('vowasia_ro.articles') IS NULL OR to_regclass('vowasia_ro.sites') IS NULL
     OR NOT has_table_privilege('vowasia_migrator', to_regclass('vowasia_ro.articles'), 'SELECT')
     OR NOT has_table_privilege('vowasia_migrator', to_regclass('vowasia_ro.sites'), 'SELECT') THEN
    RAISE EXCEPTION '02P STOP: the views of 02 or their SELECT grant are missing (02 did not end in SELF-CHECK OK); nothing was changed.';
  END IF;
  IF (SELECT rolsuper OR rolbypassrls FROM pg_roles WHERE rolname = 'vowasia_migrator')
     OR EXISTS (SELECT 1 FROM pg_auth_members m JOIN pg_roles r ON r.oid = m.member WHERE r.rolname = 'vowasia_migrator') THEN
    RAISE EXCEPTION '02P STOP: vowasia_migrator is superuser, bypasses RLS or is a member of another role; nothing was changed.';
  END IF;
  pw := replace(gen_random_uuid()::text, '-', '') || replace(gen_random_uuid()::text, '-', '');
  EXECUTE format('ALTER ROLE vowasia_migrator PASSWORD %L', pw);
  PERFORM set_config('vowasia.new_secret', pw, true);
END $$;

-- Ô kết quả cuối: giá trị mới (chỉ ở đây) và lời nhắc.
SELECT coalesce(nullif(current_setting('vowasia.new_secret', true), ''),
                'NOT SHOWN: run the whole file as ONE query in the SQL Editor') AS new_secret,
       'copy once with the cell copy button, then read -s; no screenshot; close this tab after' AS warning;
