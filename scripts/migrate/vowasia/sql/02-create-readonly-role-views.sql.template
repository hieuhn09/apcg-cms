-- OWNER-RUN. KHÔNG tự chạy. Đọc scripts/migrate/vowasia/VOWASIA-LEGACY.md trước.
--
-- 02-create-readonly-role-views.sql.template: PHƯƠNG ÁN 2 (khuyên dùng).
-- Tạo role chỉ-đọc RIÊNG vowasia_migrator và schema RIÊNG vowasia_ro chứa hai
-- view (articles, sites) lọc cứng theo id site VowAsia. KHÔNG đổi bảng gốc,
-- KHÔNG bật RLS, KHÔNG đụng role/policy/grant của site khác (kể cả gtp_migrator).
--
-- Cách dùng:
--   1. Chép file này ra NGOÀI repo, điền 3 chỗ giữ chỗ:
--        __VOWASIA_SITE_ID__   id site VowAsia (lấy từ file 01, mục 6)
--        __ARTICLE_COLUMNS__   danh sách cột TƯỜNG MINH của bảng articles, có
--                              cột site_id, KHÔNG có cột cá nhân (email, IP,
--                              ghi chú nội bộ...). Ví dụ: "id", "site_id", "title"
--        (tên bảng gốc public.articles / public.sites: sửa nếu file 01 cho thấy khác)
--   2. Chạy: psql -v ON_ERROR_STOP=1 -f <bản đã điền>
--   3. Đặt mật khẩu (KHÔNG ghi vào file này):
--        openssl rand -base64 24 | pbcopy
--        psql ... -c '\password vowasia_migrator'   (dán khi được hỏi), rồi `clear`.
--   4. Đọc kết quả TỰ KIỂM ở cuối file. Nếu nó KHÔNG phải 'SELF-CHECK OK':
--      DỪNG (HS5): không dùng role, chạy 03-drop-role-and-views.sql để dọn, báo lại.
--      Nguyên nhân thường gặp: PUBLIC có quyền trên bảng/schema public (PG 14 trở
--      xuống: PUBLIC có CREATE trên schema public), hoặc id site sai.
--
-- Ghi chú:
--   - KHÔNG chạy REVOKE ... FROM PUBLIC trên bảng/schema public: có thể làm hỏng site cũ.
--   - Role là cấp CỤM (cluster-wide), không riêng một database; role kế thừa quyền của PUBLIC.
--   - View chạy bằng quyền của chủ view (người chạy file này), nên chủ cần SELECT
--     trên bảng gốc; nếu người chạy là chủ bảng thì RLS của bảng gốc không lọc view.
--   - Danh sách cột của view bị khoá lúc tạo (nguồn đóng băng là chấp nhận được).

BEGIN;

-- Chặn chạy khi chưa điền chỗ giữ chỗ.
DO $$
BEGIN
  IF '__VOWASIA_SITE_ID__' LIKE '\_\_VOWASIA%' THEN
    RAISE EXCEPTION 'vowasia: placeholder __VOWASIA_SITE_ID__ not filled; nothing was created.';
  END IF;
END $$;

CREATE ROLE vowasia_migrator LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS CONNECTION LIMIT 3;
ALTER ROLE vowasia_migrator SET default_transaction_read_only = on;
ALTER ROLE vowasia_migrator SET statement_timeout = '30s';
ALTER ROLE vowasia_migrator SET idle_in_transaction_session_timeout = '60s';

CREATE SCHEMA vowasia_ro;
REVOKE ALL ON SCHEMA vowasia_ro FROM PUBLIC;

CREATE VIEW vowasia_ro.sites WITH (security_barrier = true) AS
  SELECT "id", "slug", "name" FROM public.sites WHERE "id" = '__VOWASIA_SITE_ID__';

CREATE VIEW vowasia_ro.articles WITH (security_barrier = true) AS
  SELECT __ARTICLE_COLUMNS__ FROM public.articles WHERE "site_id" = '__VOWASIA_SITE_ID__';

REVOKE ALL ON vowasia_ro.sites, vowasia_ro.articles FROM PUBLIC;
GRANT USAGE ON SCHEMA vowasia_ro TO vowasia_migrator;
GRANT SELECT ON vowasia_ro.sites, vowasia_ro.articles TO vowasia_migrator;

COMMIT;

-- TỰ KIỂM (chỉ đọc). Kết quả phải là đúng một dòng 'SELF-CHECK OK'.
SELECT CASE
  WHEN (SELECT count(*) FROM vowasia_ro.sites) <> 1
    THEN 'SELF-CHECK STOP: view sites does not return exactly 1 row; run 03 and report (HS5)'
  WHEN (SELECT count(*) FROM vowasia_ro.sites WHERE "slug" = 'vowasia') <> 1
    THEN 'SELF-CHECK STOP: the site row slug is not vowasia; run 03 and report (HS5)'
  WHEN has_schema_privilege('vowasia_migrator', 'public', 'CREATE')
    THEN 'SELF-CHECK STOP: vowasia_migrator can CREATE in schema public (PUBLIC grant?); run 03 and report (HS5)'
  WHEN EXISTS (
    SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
    WHERE n.nspname = 'public' AND c.relkind IN ('r', 'p', 'v', 'm', 'f')
      AND (has_table_privilege('vowasia_migrator', c.oid, 'SELECT, INSERT, UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER')
           OR has_any_column_privilege('vowasia_migrator', c.oid, 'SELECT, INSERT, UPDATE, REFERENCES')))
    THEN 'SELF-CHECK STOP: vowasia_migrator has a privilege on a table in schema public; run 03 and report (HS5)'
  WHEN (SELECT rolbypassrls OR rolsuper FROM pg_roles WHERE rolname = 'vowasia_migrator')
    THEN 'SELF-CHECK STOP: vowasia_migrator bypasses RLS or is superuser; run 03 and report (HS5)'
  ELSE 'SELF-CHECK OK'
END AS vowasia_self_check;
