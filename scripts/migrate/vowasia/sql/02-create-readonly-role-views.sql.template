-- OWNER-RUN. KHÔNG tự chạy. Đọc scripts/migrate/vowasia/VOWASIA-LEGACY.md trước.
--
-- 02-create-readonly-role-views.sql.template: PHƯƠNG ÁN 2 (khuyên dùng).
-- Tạo role chỉ-đọc RIÊNG vowasia_migrator và schema RIÊNG vowasia_ro chứa hai
-- view (articles, sites) lọc cứng theo id site VowAsia. KHÔNG đổi bảng gốc,
-- KHÔNG bật RLS, KHÔNG đụng role/policy/grant của site khác (kể cả gtp_migrator).
--
-- Cách dùng (chi tiết từng lệnh: VOWASIA-LEGACY.md, bước O3):
--   1. Chép file này ra NGOÀI repo, điền các chỗ giữ chỗ (thay HẾT mọi lần xuất hiện):
--        __VOWASIA_SITE_ID__     id site VowAsia (lấy từ file 01, mục 6)
--        __VOWASIA_SITE_SLUG__   slug của dòng site đó (công cụ discover chỉ nhận vowasia;
--                                nếu slug thật khác: DỪNG và báo, cần amendment)
--        __ARTICLE_COLUMNS__     danh sách cột TƯỜNG MINH của bảng articles, có
--                                cột site_id, KHÔNG có cột cá nhân (email, IP,
--                                ghi chú nội bộ...). Ví dụ: "id", "site_id", "title"
--        (tên bảng gốc public.articles / public.sites: sửa nếu file 01 cho thấy khác)
--   2. Chạy file đã điền bằng psql với -v ON_ERROR_STOP=1.
--   3. TỰ KIỂM chạy BÊN TRONG giao dịch, TRƯỚC COMMIT. Nếu có gì sai, nó báo
--      'SELF-CHECK STOP: ...' và cả giao dịch tự huỷ (ROLLBACK): không role, không
--      schema nào được tạo. Khi đó: DỪNG (HS5) và báo lại.
--      Nếu xong, dòng cuối là đúng 'SELF-CHECK OK'.
--   4. CHỈ SAU 'SELF-CHECK OK' mới đặt mật khẩu (bằng \password, KHÔNG ghi vào file này).
--
-- Ghi chú (nói thật về giới hạn):
--   - Role không đọc/ghi được bảng gốc, nhưng vẫn thừa hưởng quyền của PUBLIC:
--     CONNECT, TEMP (bảng tạm), EXECUTE các hàm PUBLIC gọi được. Tự kiểm chặn hàm
--     SECURITY DEFINER trong schema public; hàm ở schema khác: xem file 01 mục 5d.
--   - default_transaction_read_only chỉ là MẶC ĐỊNH của phiên (role tự tắt được);
--     hàng rào thật là: role chỉ có SELECT trên hai view.
--   - Role có hạn dùng (VALID UNTIL, 14 ngày). Nếu Giai đoạn B bị hoãn lâu hơn:
--     chạy 03 để xoá role, hoặc đổi mật khẩu bằng \password trước khi dùng lại.
--   - KHÔNG chạy REVOKE ... FROM PUBLIC trên bảng/schema public: có thể làm hỏng site cũ.
--   - Role là cấp CỤM (cluster-wide), không riêng một database.
--   - View chạy bằng quyền của chủ view (người chạy file này), nên chủ cần SELECT
--     trên bảng gốc; nếu người chạy là chủ bảng thì RLS của bảng gốc không lọc view.
--   - Danh sách cột của view bị khoá lúc tạo (nguồn đóng băng là chấp nhận được).

-- Đang nối vào đâu, bằng ai. Phải là DB CŨ (không phải Central /neondb). Sai: Ctrl+C ngay.
SELECT current_database() AS database_name, current_user AS running_as;

BEGIN;

-- Chặn chạy khi chưa điền chỗ giữ chỗ.
DO $$
BEGIN
  IF '__VOWASIA_SITE_ID__' LIKE '\_\_VOWASIA%' OR '__VOWASIA_SITE_SLUG__' LIKE '\_\_VOWASIA%' THEN
    RAISE EXCEPTION 'vowasia: placeholder __VOWASIA_SITE_ID__ / __VOWASIA_SITE_SLUG__ not filled; nothing was created.';
  END IF;
END $$;

CREATE ROLE vowasia_migrator LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT CONNECTION LIMIT 3;
DO $$
BEGIN
  EXECUTE format('ALTER ROLE vowasia_migrator VALID UNTIL %L', (now() + interval '14 days')::text);
END $$;
ALTER ROLE vowasia_migrator SET default_transaction_read_only = on;
ALTER ROLE vowasia_migrator SET statement_timeout = '30s';
ALTER ROLE vowasia_migrator SET idle_in_transaction_session_timeout = '60s';

CREATE SCHEMA vowasia_ro;
REVOKE ALL ON SCHEMA vowasia_ro FROM PUBLIC;

CREATE VIEW vowasia_ro.sites WITH (security_barrier = true) AS
  SELECT "id", "slug", "name" FROM public.sites WHERE "id" = '__VOWASIA_SITE_ID__';

CREATE VIEW vowasia_ro.articles WITH (security_barrier = true) AS
  SELECT __ARTICLE_COLUMNS__ FROM public.articles WHERE "site_id" = '__VOWASIA_SITE_ID__';

REVOKE ALL ON vowasia_ro.sites, vowasia_ro.articles FROM PUBLIC;
GRANT USAGE ON SCHEMA vowasia_ro TO vowasia_migrator;
GRANT SELECT ON vowasia_ro.sites, vowasia_ro.articles TO vowasia_migrator;

-- TỰ KIỂM, TRONG giao dịch: RAISE EXCEPTION => cả giao dịch huỷ, không tạo gì.
DO $$
DECLARE
  bad text;
  n_definer int;
BEGIN
  IF (SELECT count(*) FROM vowasia_ro.sites) <> 1 THEN
    RAISE EXCEPTION 'SELF-CHECK STOP: view sites does not return exactly 1 row (wrong site id?); nothing was created (HS5)';
  END IF;
  IF (SELECT count(*) FROM vowasia_ro.sites WHERE "slug" = '__VOWASIA_SITE_SLUG__') <> 1 THEN
    RAISE EXCEPTION 'SELF-CHECK STOP: the site row slug is not the expected slug; nothing was created (HS5)';
  END IF;
  IF (SELECT rolbypassrls OR rolsuper FROM pg_roles WHERE rolname = 'vowasia_migrator') THEN
    RAISE EXCEPTION 'SELF-CHECK STOP: vowasia_migrator bypasses RLS or is superuser; nothing was created (HS5)';
  END IF;
  IF EXISTS (SELECT 1 FROM pg_auth_members m JOIN pg_roles r ON r.oid = m.member WHERE r.rolname = 'vowasia_migrator') THEN
    RAISE EXCEPTION 'SELF-CHECK STOP: vowasia_migrator is a member of another role; nothing was created (HS5)';
  END IF;
  IF has_database_privilege('vowasia_migrator', current_database(), 'CREATE') THEN
    RAISE EXCEPTION 'SELF-CHECK STOP: vowasia_migrator can CREATE in this database (PUBLIC grant?); nothing was created (HS5)';
  END IF;
  SELECT string_agg(n.nspname, ', ') INTO bad FROM pg_namespace n
  WHERE has_schema_privilege('vowasia_migrator', n.oid, 'CREATE');
  IF bad IS NOT NULL THEN
    RAISE EXCEPTION 'SELF-CHECK STOP: vowasia_migrator can CREATE in a schema (PUBLIC grant?); nothing was created (HS5)';
  END IF;
  IF EXISTS (
    SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
    WHERE n.nspname NOT IN ('vowasia_ro', 'pg_catalog', 'information_schema', 'pg_toast')
      AND c.relkind IN ('r', 'p', 'v', 'm', 'f')
      AND has_schema_privilege('vowasia_migrator', n.oid, 'USAGE')
      AND (has_table_privilege('vowasia_migrator', c.oid, 'SELECT, INSERT, UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER')
           OR has_any_column_privilege('vowasia_migrator', c.oid, 'SELECT, INSERT, UPDATE, REFERENCES'))) THEN
    RAISE EXCEPTION 'SELF-CHECK STOP: vowasia_migrator has a privilege on a table outside vowasia_ro (PUBLIC grant?); nothing was created (HS5)';
  END IF;
  IF EXISTS (
    SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
    WHERE n.nspname = 'public' AND p.prosecdef
      AND has_function_privilege('vowasia_migrator', p.oid, 'EXECUTE')) THEN
    RAISE EXCEPTION 'SELF-CHECK STOP: vowasia_migrator can EXECUTE a SECURITY DEFINER function in schema public; nothing was created (HS5)';
  END IF;
  SELECT count(*) INTO n_definer FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
  WHERE n.nspname NOT IN ('pg_catalog', 'information_schema', 'public') AND p.prosecdef
    AND has_schema_privilege('vowasia_migrator', n.oid, 'USAGE')
    AND has_function_privilege('vowasia_migrator', p.oid, 'EXECUTE');
  RAISE NOTICE 'vowasia: SECURITY DEFINER functions in other schemas callable by the role: % (see file 01, 5d)', n_definer;
  RAISE NOTICE 'vowasia: inherited from PUBLIC: CONNECT=%, TEMP=%',
    has_database_privilege('vowasia_migrator', current_database(), 'CONNECT'),
    has_database_privilege('vowasia_migrator', current_database(), 'TEMP');
END $$;

COMMIT;

SELECT 'SELF-CHECK OK' AS vowasia_self_check;
