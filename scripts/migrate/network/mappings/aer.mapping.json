{
  "version": 1,
  "_provisional": ["categories.map", "authors.distribute", "authors.bySection", "tags.keepOnly", "media.bodyImages", "urls.oldOrigin", "urls.sectionPaths", "urls.extraLegacyPaths", "urls.gonePaths", "archivedAs"],
  "_evidence": "STRUCTURAL mapping for the Asia Economic Review legacy import (aer-launch W4). No site id, no image host: those live in the owner-held overlay ~/aer-private/overlay.json. Every key in _provisional is an OWNER DECISION still open; the values are SUGGESTIONS only and --require-final (implied for any non-local run) refuses them. Old section values below are GUESSED from the live site's URL paths (/essays, /briefings, /corporate-asia, /the-review-interview, /the-long-view, /in-focus, /data-annual, /partner-insights) and must be checked against the discovery result (section counts) before the decision. Open decisions: (1) categories.map: old Essays beats look like the new Asia Watch sub-sections while the design's The Long View holds essays; suggestion below sends essays to asia-watch (alternative: long-view); data-annual and partner-insights have no obvious home (suggestion: in-focus and corporate-asia). Sub-sections are left empty until discovery shows the old subsection values. (2) authors: bySection (preserves what readers saw on the old Team page) vs slugHash (D7, even split); suggestion bySection. (3) tags.keepOnly: only the 6 approved tags survive (D6). (4) media.bodyImages: drop (default, counted) or hero-if-missing. (5) archivedAs section (301) vs 410. (6) old origin apex or www.",
  "source": {
    "schema": "aer_ro",
    "tableAllowList": ["articles", "sites", "site_authors"],
    "columns": {
      "id": "id", "slug": "slug", "title": "title", "dek": "excerpt", "kicker": "kicker", "body": "body_sections", "status": "status",
      "section": "section", "subsection": "subsection", "tags": "tags", "format": "format", "featured": "featured", "isHero": "is_hero",
      "readMinutes": "read_minutes", "heroImage": "featured_image", "heroCredit": "featured_image_credit", "seo": "seo",
      "sourceUrl": "source_url", "byline": "byline", "takeaways": "takeaways", "countries": "countries",
      "publishedAt": "published_at", "createdAt": "created_at", "updatedAt": "updated_at"
    }
  },
  "body": { "format": "sections", "converter": "html-to-lexical", "lineBreaks": "space" },
  "status": {
    "map": { "published": "published", "archived": "archived", "draft": "draft", "scheduled": "draft", "rejected": "SKIP" },
    "unknown": "reject"
  },
  "categories": {
    "map": {
      "essays/*": { "pillar": "asia-watch" },
      "briefings/*": { "pillar": "briefings" },
      "corporate-asia/*": { "pillar": "corporate-asia" },
      "the-review-interview/*": { "pillar": "interviews" },
      "the-long-view/*": { "pillar": "long-view" },
      "in-focus/*": { "pillar": "in-focus" },
      "data-annual/*": { "pillar": "in-focus" },
      "partner-insights/*": { "pillar": "corporate-asia" }
    },
    "fallback": null,
    "unmapped": "reject"
  },
  "authors": {
    "resolve": "byColumn",
    "map": {},
    "staff": ["Lena Ho", "Arjun Menon", "Mei Fong Chua", "Rahul Sethi"],
    "distribute": { "pool": ["Lena Ho", "Arjun Menon", "Mei Fong Chua", "Rahul Sethi"], "keepLegacy": false, "groupBy": "none", "maxSpread": 1, "mode": "bySection" },
    "bySection": { "briefings": "Lena Ho", "corporate-asia": "Arjun Menon", "the-long-view": "Mei Fong Chua", "essays": "Rahul Sethi" },
    "createMissing": false
  },
  "tags": { "keepOnly": ["china", "india", "japan", "south-korea", "indonesia", "vietnam"], "renames": { "korea": "south-korea", "viet-nam": "vietnam" } },
  "formatTags": { "enabled": false, "include": [] },
  "countries": { "match": "either" },
  "readMin": { "wpm": 230 },
  "pin": { "fromFlags": false, "maxPinned": 0 },
  "archivedAs": "section",
  "events": { "enabled": false },
  "slug": { "preserve": true, "dedupe": "numeric-suffix", "reservedSlugs": [] },
  "urls": {
    "oldOrigin": "https://asiaeconomicreview.com",
    "articlePathTemplate": "/article/{slug}",
    "sectionPaths": {
      "essays": "/essays", "briefings": "/briefings", "corporate-asia": "/corporate-asia", "the-review-interview": "/the-review-interview",
      "the-long-view": "/the-long-view", "in-focus": "/in-focus", "data-annual": "/data-annual", "partner-insights": "/partner-insights"
    },
    "extraLegacyPaths": ["/team"],
    "gonePaths": ["/corrections"]
  },
  "media": { "maxBytes": 20971520, "failureBudgetPercent": 2, "fetchTimeoutMs": 30000, "concurrency": 3, "hotlinkPolicy": "download", "bodyImages": "drop" }
}
